# Copiar a .env y completar. Nunca commitear .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3250
DATABASE_URL=postgresql://postgres@127.0.0.1:5444/cavi_dev?schema=public
# Mínimo 32 caracteres. En producción: openssl rand -base64 48
# Cambiarlo después cierra las sesiones, anula las claves temporales emitidas y deja fallidos los correos pendientes.
JWT_SECRET=
# Dirección pública del sitio: los enlaces de los correos se arman con ella.
SITIO_URL=http://localhost:3251
# true en producción (HTTPS). false solo en desarrollo local por http.
COOKIE_SECURE=false
# true detrás de nginx en producción, para que los límites por IP vean la IP real.
TRUST_PROXY=false
LOG_LEVEL=info
LOG_PRETTY=true

# Correo. En desarrollo va a Mailpit (SMTP 127.0.0.1:1025 sin usuario ni TLS; buzón web en
# http://127.0.0.1:8025). En producción, el buzón SMTP del dominio repcavi.com.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# true para el puerto 465 (TLS directo); false para 587 (STARTTLS) y para Mailpit.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Nombre y dirección que ve el cliente como remitente.
CORREO_REMITENTE="Repuestos CAVI <no-responder@repcavi.com>"
# A dónde llegan los avisos para CAVI (solicitud nueva, aceptada, cancelada, contacto).
CORREO_AVISOS_CAVI=marketing@repcavi.com
# Tope de correos por hora entre todos los tipos. Al pasarlo, el correo queda «fallido» y se reenvía desde el panel.
CORREO_TOPE_HORA=200

# Fotos de los vehículos. Fuera de lo que sirve nginx.
ARCHIVOS_DIR=archivos
# Días que se guarda la foto de una cotización entregada o cancelada, contados desde su último movimiento.
FOTOS_RETENCION_DIAS=180

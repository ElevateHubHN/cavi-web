{
  "name": "cavi-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repuestos CAVI - API de cotizaciones, cuentas de clientes, correos y panel",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "crear-admin": "node dist/scripts/crear-admin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/jwt": "10.2.5",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.3",
    "dotenv": "16.6.1",
    "fastify": "5.12.5",
    "nodemailer": "10.4.1",
    "pino": "9.14.0",
    "pino-pretty": "11.3.0",
    "prisma": "5.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
